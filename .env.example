# EvoLink decision model. Fill the key locally; no credentials are bundled.
DECISION_PROVIDER=evolink
EVOLINK_API_KEY=
EVOLINK_BASE_URL=https://direct.evolink.ai
EVOLINK_MODEL=gpt-6-luna-decisions
# Optional original provider: DECISION_PROVIDER=typesafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. Put the same EvoLink key in this field.
# Use the literal key value: the inspector does not expand ${VARIABLE} references.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.evolink.ai/v1
TEXT_MODEL=gpt-6-luna
TEXT_MODEL_REASONING=none
